{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "run-command",
  "name": "Run Command",
  "version": "0.2.0",
  "description": "Type a shell command in the sidebar, press Enter, and it runs in a terminal of the current workspace without leaving your chat. Keeps recent commands, never their output or anything that looks like a secret.",
  "author": {
    "name": "Ronan Connolly",
    "url": "https://github.com/RonanCodes"
  },
  "repository": "https://github.com/RonanCodes/orca-run-command",
  "homepage": "https://github.com/RonanCodes/orca-run-command",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "capabilities": [
    {
      "kind": "storage:own"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "agent:read"
    },
    {
      "kind": "terminal:send"
    }
  ],
  "contributes": {
    "panels": [
      {
        "id": "run-command",
        "title": "Run Command",
        "icon": "terminal",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "commands": [
      {
        "id": "run.again",
        "title": "Run Command: Run the last command again",
        "when": "workspace"
      },
      {
        "id": "run.history",
        "title": "Run Command: Show recent commands"
      }
    ]
  },
  "icon": "assets/icon.png"
}
