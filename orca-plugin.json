{
  "manifestVersion": 2,
  "id": "run-command",
  "name": "Run Command",
  "version": "0.1.0",
  "description": "Type a one-off shell command in a sidebar panel and run it in a terminal of the current workspace, without leaving the chat. A stopgap for `!` commands in Orca's chat view.",
  "author": {
    "name": "Ronan Connolly",
    "url": "https://github.com/RonanCodes"
  },
  "repository": "https://github.com/RonanCodes/orca-run-command",
  "homepage": "https://github.com/RonanCodes/orca-run-command",
  "license": "MIT",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "capabilities": [
    { "kind": "storage:own" },
    { "kind": "workspace:read" },
    { "kind": "agent:read" },
    { "kind": "terminal:send" }
  ],
  "contributes": {
    "panels": [
      {
        "id": "run-command",
        "title": "Run Command",
        "icon": "terminal",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "commands": [
      { "id": "run.again", "title": "Run Command: Run the last command again", "when": "workspace" },
      { "id": "run.history", "title": "Run Command: Show recent commands" }
    ]
  }
}
